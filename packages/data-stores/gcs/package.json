{
  "name": "@uploadista/data-store-gcs",
  "type": "module",
  "version": "1.0.0-beta.4",
  "description": "Google Cloud Storage data store for Uploadista",
  "license": "MIT",
  "author": "Uploadista",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "check": "biome check --write ./src",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/storage": "7.21.0",
    "@uploadista/core": "workspace:*",
    "@uploadista/observability": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^3.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@uploadista/kv-store-memory": "workspace:*",
    "@uploadista/typescript-config": "workspace:*",
    "effect": "catalog:",
    "tsdown": "catalog:",
    "vitest": "4.0.18"
  }
}
