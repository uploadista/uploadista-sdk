{
  "name": "@uploadista/data-store-azure",
  "type": "module",
  "version": "0.0.8",
  "description": "Azure Blob Storage data store for Uploadista",
  "license": "MIT",
  "author": "Uploadista",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "check": "biome check --write ./src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/core-auth": "^1.8.0",
    "@azure/storage-blob": "12.29.1",
    "@uploadista/core": "workspace:*",
    "@uploadista/kv-store-memory": "workspace:*",
    "@uploadista/observability": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@uploadista/typescript-config": "workspace:*",
    "tsdown": "catalog:"
  }
}
