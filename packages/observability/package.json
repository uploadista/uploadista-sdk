{
  "name": "@uploadista/observability",
  "type": "module",
  "version": "0.0.13-beta.5",
  "description": "Observability package for Uploadista",
  "license": "MIT",
  "author": "Uploadista",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "check": "biome check --write ./src",
    "clean": "rimraf -rf dist && rimraf -rf .turbo && rimraf tsconfig.tsbuildinfo",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@effect/opentelemetry": "0.59.0",
    "@opentelemetry/sdk-logs": "0.208.0",
    "@opentelemetry/sdk-metrics": "2.2.0",
    "@opentelemetry/sdk-trace-base": "2.2.0",
    "@opentelemetry/sdk-trace-node": "2.2.0",
    "@opentelemetry/sdk-trace-web": "2.2.0",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251111.0",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@uploadista/typescript-config": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "4.0.8"
  }
}
