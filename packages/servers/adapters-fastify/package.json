{
  "name": "@uploadista/adapters-fastify",
  "type": "module",
  "version": "0.0.13-beta.3",
  "description": "Fastify adapter for Uploadista",
  "license": "MIT",
  "author": "Uploadista",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "check": "biome check --write ./src",
    "clean": "rimraf -rf dist && rimraf -rf .turbo && rimraf tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@uploadista/core": "workspace:*",
    "@uploadista/observability": "workspace:*",
    "@uploadista/event-broadcaster-memory": "workspace:*",
    "@uploadista/event-emitter-websocket": "workspace:*",
    "@uploadista/server": "workspace:*",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@uploadista/typescript-config": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "fastify": "^4.0.0 || ^5.0.0",
    "@fastify/websocket": "^10.0.0 || ^11.0.0"
  }
}
