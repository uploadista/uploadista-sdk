{
  "name": "@uploadista/adapters-express",
  "type": "module",
  "version": "0.1.1-beta.3",
  "description": "Express adapter for Uploadista",
  "license": "MIT",
  "author": "Uploadista",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "check": "biome check --write ./src",
    "clean": "rimraf -rf dist && rimraf -rf .turbo && rimraf tsconfig.tsbuildinfo",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@uploadista/core": "workspace:*",
    "@uploadista/observability": "workspace:*",
    "@uploadista/event-broadcaster-memory": "workspace:*",
    "@uploadista/event-emitter-websocket": "workspace:*",
    "@uploadista/server": "workspace:*",
    "ws": "8.19.0"
  },
  "peerDependencies": {
    "effect": "^3.0.0",
    "express": "^4.0.0 || ^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "@types/ws": "8.18.1",
    "@uploadista/typescript-config": "workspace:*",
    "effect": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "4.0.17",
    "zod": "catalog:"
  }
}
