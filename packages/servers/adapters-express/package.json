{
  "name": "@uploadista/adapters-express",
  "type": "module",
  "version": "0.0.4",
  "description": "Express adapter for Uploadista",
  "license": "MIT",
  "author": "Uploadista",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "check": "biome check --write ./src",
    "clean": "rimraf -rf dist && rimraf -rf .turbo && rimraf tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@uploadista/core": "workspace:*",
    "@uploadista/observability": "workspace:*",
    "@uploadista/event-broadcaster-memory": "workspace:*",
    "@uploadista/event-emitter-websocket": "workspace:*",
    "@uploadista/server": "workspace:*",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "@uploadista/typescript-config": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  }
}
