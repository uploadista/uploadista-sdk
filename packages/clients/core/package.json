{
  "name": "@uploadista/client-core",
  "type": "module",
  "version": "0.0.8",
  "description": "Platform-agnostic core upload client logic for Uploadista",
  "license": "MIT",
  "author": "Uploadista",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js"
    },
    "./upload": {
      "types": "./dist/upload/index.d.ts",
      "import": "./dist/upload/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "check": "biome check --write ./src"
  },
  "dependencies": {
    "@uploadista/core": "workspace:*",
    "js-base64": "3.7.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@uploadista/typescript-config": "workspace:*",
    "tsdown": "catalog:",
    "vitest": "4.0.7"
  }
}
