{
  "name": "@uploadista/client-core",
  "type": "module",
  "version": "0.0.20-beta.7",
  "description": "Platform-agnostic core upload client logic for Uploadista",
  "license": "MIT",
  "author": "Uploadista",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./types": {
      "types": "./dist/types/index.d.mts",
      "import": "./dist/types/index.mjs"
    },
    "./services": {
      "types": "./dist/services/index.d.mts",
      "import": "./dist/services/index.mjs"
    },
    "./upload": {
      "types": "./dist/upload/index.d.mts",
      "import": "./dist/upload/index.mjs"
    },
    "./managers": {
      "types": "./dist/managers/index.d.mts",
      "import": "./dist/managers/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.mts",
      "import": "./dist/testing/index.mjs"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "check": "biome check --write ./src"
  },
  "dependencies": {
    "@uploadista/core": "workspace:*",
    "js-base64": "3.7.8"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@uploadista/typescript-config": "workspace:*",
    "tsdown": "catalog:",
    "vitest": "4.0.15",
    "zod": "catalog:"
  }
}
