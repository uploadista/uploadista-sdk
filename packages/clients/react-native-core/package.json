{
  "name": "@uploadista/react-native-core",
  "version": "0.1.0",
  "type": "module",
  "description": "React Native client for Uploadista with mobile-optimized upload patterns",
  "exports": {
    ".": "./src/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./components": "./src/components/index.ts",
    "./utils": "./src/utils/index.ts",
    "./services": "./src/services/index.ts"
  },
  "scripts": {
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "check": "biome check --write ./src"
  },
  "dependencies": {
    "@uploadista/core": "workspace:*",
    "@uploadista/client-core": "workspace:*",
    "uuid": "^10.0.0",
    "js-base64": "^3.7.7"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.71.0",
    "@react-native-async-storage/async-storage": ">=1.17.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@uploadista/typescript-config": "workspace:*",
    "@types/react": ">=18.0.0",
    "@types/react-native": ">=0.71.0",
    "@types/uuid": "^10.0.0"
  }
}
