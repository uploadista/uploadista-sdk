{
  "name": "@uploadista/vue",
  "type": "module",
  "version": "0.1.0-beta.5",
  "description": "Vue client for Uploadista",
  "license": "MIT",
  "author": "Uploadista",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./composables": {
      "types": "./dist/composables/index.d.mts",
      "import": "./dist/composables/index.mjs"
    },
    "./components": {
      "types": "./dist/components/index.d.mts",
      "import": "./dist/components/index.mjs"
    },
    "./providers": {
      "types": "./dist/providers/index.d.mts",
      "import": "./dist/providers/index.mjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.mts",
      "import": "./dist/utils/index.mjs"
    }
  },
  "scripts": {
    "build": "vue-tsc --noEmit && tsdown",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "check": "biome check --write ./src",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest --watch"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@uploadista/client-core": "workspace:*",
    "@uploadista/client-browser": "workspace:*",
    "@uploadista/core": "workspace:*"
  },
  "devDependencies": {
    "@uploadista/typescript-config": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.0",
    "tsdown": "catalog:",
    "unplugin-vue": "^7.0.2",
    "vitest": "4.0.17",
    "vue": "^3.5.0",
    "vue-tsc": "3.2.2"
  }
}
