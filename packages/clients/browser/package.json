{
  "name": "@uploadista/client-browser",
  "type": "module",
  "version": "0.0.9",
  "description": "Browser client for Uploadista",
  "license": "MIT",
  "author": "Uploadista",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./flow": {
      "types": "./dist/flow/index.d.ts",
      "import": "./dist/flow/index.js"
    },
    "./upload": {
      "types": "./dist/upload/index.d.ts",
      "import": "./dist/upload/index.js"
    },
    "./framework-utils": {
      "types": "./dist/framework-utils.d.ts",
      "import": "./dist/framework-utils.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "check": "biome check --write ./src ",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@uploadista/client-core": "workspace:*",
    "@uploadista/core": "workspace:*",
    "js-base64": "3.7.8"
  },
  "devDependencies": {
    "@uploadista/typescript-config": "workspace:*",
    "tsdown": "catalog:",
    "vitest": "4.0.7"
  }
}
