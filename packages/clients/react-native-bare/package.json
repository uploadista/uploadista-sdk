{
  "name": "@uploadista/react-native-bare",
  "type": "module",
  "description": "Bare React Native Client for Uploadista",
  "version": "1.0.0-beta.2",
  "license": "MIT",
  "author": "Uploadista",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "check": "biome check --write ./src"
  },
  "dependencies": {
    "@uploadista/client-core": "workspace:*",
    "@uploadista/react-native-core": "workspace:*"
  },
  "peerDependencies": {
    "js-base64": ">=3.7.0",
    "uuid": ">=13.0.0",
    "react": ">=16.8.0",
    "react-native": ">=0.71.0",
    "@react-native-documents/picker": ">=10.0.0",
    "react-native-image-picker": ">=7.0.0",
    "react-native-quick-crypto": ">=0.7.0",
    "rn-fetch-blob": ">=0.12.0",
    "@react-native-async-storage/async-storage": ">=1.19.0"
  },
  "peerDependenciesMeta": {
    "@react-native-documents/picker": {
      "optional": true
    },
    "react-native-image-picker": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@uploadista/typescript-config": "workspace:*",
    "@types/react": ">=18.0.0",
    "tsdown": "catalog:"
  }
}
