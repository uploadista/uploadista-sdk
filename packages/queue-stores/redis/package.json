{
  "name": "@uploadista/queue-store-redis",
  "type": "module",
  "version": "1.0.0-beta.1",
  "description": "Redis-backed flow queue store for Uploadista",
  "license": "MIT",
  "author": "Uploadista",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "check": "biome check --write ./src",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@uploadista/core": "workspace:*",
    "@uploadista/kv-store-redis": "workspace:*"
  },
  "peerDependencies": {
    "@redis/client": ">=5.8.0 <6.0.0",
    "effect": "^3.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@redis/client": "5.11.0",
    "@uploadista/typescript-config": "workspace:*",
    "effect": "catalog:",
    "tsdown": "catalog:",
    "vitest": "4.0.18"
  }
}
