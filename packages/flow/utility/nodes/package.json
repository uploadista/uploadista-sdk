{
  "name": "@uploadista/flow-utility-nodes",
  "type": "module",
  "version": "0.0.13-beta.3",
  "description": "Utility nodes for Uploadista Flow",
  "license": "MIT",
  "author": "Uploadista",
  "exports": {
    "./nodes": {
      "types": "./dist/nodes/index.d.mts",
      "import": "./dist/nodes/index.mjs",
      "require": "./dist/nodes/index.cjs",
      "default": "./dist/nodes/index.mjs"
    },
    "./types": {
      "types": "./dist/types/index.d.mts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.cjs",
      "default": "./dist/types/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "check": "biome check --write ./src"
  },
  "dependencies": {
    "@uploadista/core": "workspace:*",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@uploadista/typescript-config": "workspace:*",
    "tsdown": "catalog:"
  }
}
