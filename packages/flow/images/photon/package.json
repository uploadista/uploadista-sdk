{
  "name": "@uploadista/flow-images-photon",
  "type": "module",
  "version": "0.1.0-beta.4",
  "description": "Photon image processing service for Uploadista Flow",
  "license": "MIT",
  "author": "Uploadista",
  "exports": {
    "./node": {
      "types": "./dist/node.d.mts",
      "import": "./dist/node.mjs",
      "require": "./dist/node.cjs",
      "default": "./dist/node.mjs"
    },
    "./serverless": {
      "types": "./dist/serverless.d.mts",
      "import": "./dist/serverless.mjs",
      "require": "./dist/serverless.cjs",
      "default": "./dist/serverless.mjs"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "check": "biome check --write ./src",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@cf-wasm/photon": "0.3.4",
    "@uploadista/core": "workspace:*",
    "@uploadista/observability": "workspace:*",
    "tinycolor2": "1.6.0"
  },
  "peerDependencies": {
    "effect": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/tinycolor2": "1.4.6",
    "@uploadista/typescript-config": "workspace:*",
    "effect": "catalog:",
    "tsdown": "catalog:",
    "vitest": "4.0.17",
    "zod": "catalog:"
  }
}
