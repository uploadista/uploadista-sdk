{
  "name": "@uploadista/flow-images-photon",
  "type": "module",
  "version": "0.0.9",
  "description": "Photon image processing service for Uploadista Flow",
  "license": "MIT",
  "author": "Uploadista",
  "exports": {
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./serverless": {
      "types": "./dist/serverless.d.ts",
      "import": "./dist/serverless.js",
      "default": "./dist/serverless.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "check": "biome check --write ./src"
  },
  "dependencies": {
    "@cf-wasm/photon": "0.1.31",
    "@uploadista/core": "workspace:*",
    "effect": "catalog:",
    "tinycolor2": "1.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/tinycolor2": "1.4.6",
    "@uploadista/typescript-config": "workspace:*",
    "tsdown": "catalog:"
  }
}
