{
  "name": "@uploadista/flow-images-sharp",
  "type": "module",
  "version": "1.0.0",
  "description": "Sharp image processing service for Uploadista Flow",
  "license": "MIT",
  "author": "Uploadista",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "check": "biome check --write ./src",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "sharp": "0.35.3",
    "@uploadista/core": "workspace:*",
    "@uploadista/observability": "workspace:*",
    "tinycolor2": "1.6.0"
  },
  "peerDependencies": {
    "effect": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/tinycolor2": "1.4.6",
    "@uploadista/typescript-config": "workspace:*",
    "effect": "catalog:",
    "tsdown": "catalog:",
    "vitest": "4.1.10",
    "zod": "catalog:"
  }
}
