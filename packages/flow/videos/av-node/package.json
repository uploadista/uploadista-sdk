{
  "name": "@uploadista/flow-videos-av-node",
  "type": "module",
  "version": "0.0.20",
  "description": "FFmpeg video processing plugin for Uploadista Flow with av-node",
  "license": "MIT",
  "author": "Uploadista",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "check": "biome check --write ./src",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "node-av": "5.0.3",
    "@uploadista/core": "workspace:*",
    "@uploadista/observability": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@uploadista/typescript-config": "workspace:*",
    "effect": "catalog:",
    "tsdown": "catalog:",
    "vitest": "4.0.15",
    "zod": "catalog:"
  }
}
