{
  "name": "uploadista-sdk",
  "private": true,
  "version": "0.0.2",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo run build --filter=\"./packages/**/*\"",
    "dev": "turbo watch build --filter=\"./packages/**/*\"",
    "test": "turbo test --filter=\"./packages/**/*\"",
    "release": "turbo --filter \"./packages/**/*\" build && bumpp && pnpm --filter \"./packages/**/*\" --filter !@uploadista/typescript-config publish --access public --no-git-checks",
    "release:npm_only": "pnpm --filter \"./packages/**/*\" --filter !@uploadista/typescript-config publish --access public --no-git-checks",
    "release:no-build": "bumpp && pnpm -r publish --access public --no-git-checks --tag next",
    "release:canary": "turbo --filter \"./packages/**/*\" build && bumpp && pnpm -r publish --access public --tag canary --no-git-checks",
    "pub": "pnpm --filter @uploadista/core publish --access public --no-git-checks",
    "bump": "bumpp",
    "changelog": "changelogen --output CHANGELOG.md",
    "changelog:github": "changelogithub"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@nx/js": "22.5.1",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.18",
    "@swc/helpers": "0.5.19",
    "bumpp": "11.1.0",
    "changelogen": "^0.6.2",
    "changelogithub": "^14.0.0",
    "nx": "22.5.1",
    "rimraf": "6.1.3",
    "tinyglobby": "0.2.15",
    "turbo": "2.8.17",
    "typescript": "catalog:"
  },
  "volta": {
    "node": "24.13.0",
    "pnpm": "10.32.1"
  },
  "workspaces": [
    "packages/**",
    "examples/**",
    "apps/**"
  ],
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "core-js-pure",
    "unrs-resolver"
  ]
}
