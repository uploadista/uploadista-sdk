{
  "name": "uploadista-sdk",
  "private": true,
  "version": "0.0.2",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build": "turbo run build --filter=\"./packages/**/*\"",
    "dev": "turbo watch build --filter=\"./packages/**/*\"",
    "test": "turbo test --filter=\"./packages/**/*\"",
    "release": "turbo --filter \"./packages/**/*\" build && bumpp && pnpm --filter \"./packages/**/*\" --filter !@uploadista/typescript-config publish --access restricted --no-git-checks",
    "release:no-build": "bumpp && pnpm -r publish --access restricted --no-git-checks --tag next",
    "release:canary": "turbo --filter \"./packages/**/*\" build && bumpp && pnpm -r publish --access restricted --tag canary --no-git-checks",
    "pub": "pnpm --filter @uploadista/core publish --access restricted --no-git-checks",
    "bump": "bumpp"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@nx/js": "22.2.3",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.5",
    "@swc/helpers": "0.5.17",
    "bumpp": "10.3.2",
    "nx": "22.2.3",
    "rimraf": "6.1.2",
    "tinyglobby": "0.2.15",
    "turbo": "2.6.3",
    "typescript": "catalog:"
  },
  "volta": {
    "node": "24.12.0",
    "pnpm": "10.25.0"
  },
  "workspaces": [
    "packages/**",
    "examples/**",
    "apps/**"
  ],
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "core-js-pure",
    "unrs-resolver"
  ],
  "dependencies": {}
}
