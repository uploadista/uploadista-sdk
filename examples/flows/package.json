{
  "name": "@uploadista/example-flows",
  "version": "0.0.1",
  "description": "Example flow definitions for Uploadista SDK server examples",
  "license": "MIT",
  "author": "Uploadista",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsc -b",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "check": "biome check --write ./src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@uploadista/core": "workspace:*",
    "@uploadista/flow-images-nodes": "workspace:*",
    "@uploadista/flow-videos-nodes": "workspace:*",
    "@uploadista/flow-utility-nodes": "workspace:*",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@uploadista/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:"
  }
}
